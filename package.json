{
  "name": "gitops-enhanced-plugin",
  "version": "0.1.0",
  "description": "Enhanced GitOps console plugin with Argo CD API integration",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && NODE_ENV=production npm run webpack",
    "build-dev": "npm run clean && npm run webpack",
    "start": "webpack serve --progress --config webpack.config.ts",
    "test": "LANG=en_US.UTF-8 jest",
    "coverage": "npm test -- --coverage",
    "lint": "eslint --fix src/",
    "webpack": "webpack --config webpack.config.ts"
  },
  "devDependencies": {
    "@openshift-console/dynamic-plugin-sdk": "^1.6.0",
    "@openshift-console/dynamic-plugin-sdk-webpack": "^1.3.0",
    "@patternfly/react-core": "^6.4.3",
    "@patternfly/react-icons": "^6.4.0",
    "@patternfly/react-table": "^6.4.3",
    "@patternfly/react-topology": "^5.4.1",
    "@swc/core": "^1.15.32",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^12.1.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/react": "^17.0.80",
    "@types/react-dom": "^17.0.25",
    "@types/react-router-dom": "^5.3.3",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.4",
    "i18next": "^23.16.8",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-i18next": "^11.18.6",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.0"
  },
  "consolePlugin": {
    "name": "gitops-enhanced",
    "version": "0.1.0",
    "displayName": "GitOps Enhanced",
    "description": "Enhanced GitOps management with Argo CD API integration",
    "exposedModules": {
      "ApplicationListPage": "./components/ApplicationList/ApplicationListPage",
      "ApplicationDetailPage": "./components/ApplicationDetail/ApplicationDetailPage",
      "ApplicationCreatePage": "./components/ApplicationCreate/ApplicationCreatePage",
      "GitOpsDashboardCard": "./components/Dashboard/GitOpsDashboardPage",
      "NamespaceGitOpsTab": "./components/NamespaceTab/NamespaceGitOpsTab",
      "ApplicationSetListPage": "./components/ApplicationSet/ApplicationSetListPage",
      "ApplicationSetDetailPage": "./components/ApplicationSet/ApplicationSetDetailPage",
      "AppProjectListPage": "./components/AppProject/AppProjectListPage",
      "AppProjectDetailPage": "./components/AppProject/AppProjectDetailPage",
      "SettingsPage": "./components/Settings/SettingsPage",
      "TopologyDataFactory": "./topology/TopologyDataFactory",
      "TopologyComponentFactory": "./topology/TopologyComponentFactory"
    },
    "dependencies": {
      "@console/pluginAPI": "*"
    }
  }
}
